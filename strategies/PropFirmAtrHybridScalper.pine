//@version=5
strategy("Prop Firm ATR Hybrid Scalper (Trader MNQ)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.05)

// ---------------------------------------------------------
// Reference: IQCapital Prop Firm Trader MNQ Strategy (https://youtu.be/snaP5117MxI)
// ---------------------------------------------------------

// Inputs
atrPeriod     = input.int(14, "ATR Period", minval=1)
atrMult       = input.float(3.1, "Dynamic ATR Band Multiplier", step=0.1)
tpMult        = input.float(2.0, "Take Profit Multiplier (x ATR)", step=0.1)
slMult        = input.float(1.5, "Stop Loss Multiplier (x ATR)", step=0.1)
maxRiskPct    = input.float(0.5, "Max Account Risk Per Trade (%)", step=0.1)
skipOpenBar   = input.bool(true, "Skip First Session Candle")

// 1. Calculations
atrVal = ta.atr(atrPeriod)
prevClose = close[1]
prevAtr   = atrVal[1]

// Dynamic ATR Envelopes (Anchored to previous close)
lowerAtrBand = prevClose - (atrMult * prevAtr)
upperAtrBand = prevClose + (atrMult * prevAtr)

plot(lowerAtrBand, "Lower ATR Band (3.1x)", color=color.new(color.teal, 30), linewidth=2)
plot(upperAtrBand, "Upper ATR Band (3.1x)", color=color.new(color.maroon, 50), linewidth=1, style=plot.style_linebr)

// 2. Bar Geometry & Candlestick Anatomy
barRange   = math.max(high - low, syminfo.mintick)
bodySize   = math.abs(close - open)
upperWick  = high - math.max(close, open)
lowerWick  = math.min(close, open) - low

bodyRatio  = bodySize / barRange
upperRatio = upperWick / barRange
lowerRatio = lowerWick / barRange

// Shooting Star Rejection Pattern (Objective definition from video)
isShootingStar = (upperWick >= 2.0 * bodySize) and (lowerWick <= 0.12 * upperWick) and (upperRatio >= 0.38)

// 3. Macro Daily Regime Filter (Upgrade from video)
// Check if previous 1-day candle closed in the red
dailyClose = request.security(syminfo.tickerid, "D", close[1])
dailyOpen  = request.security(syminfo.tickerid, "D", open[1])
isDailyBearish = dailyClose < dailyOpen

// 4. Long Strategy Logic (Intrabar ATR Dip Rejection Limit Scalp)
longCondition = (low <= lowerAtrBand) and not na(prevAtr)

var float longEntryPrice = na
var float longTP = na
var float longSL = na

if (longCondition and strategy.position_size == 0)
    longEntryPrice := lowerAtrBand
    longTP := lowerAtrBand + (tpMult * prevAtr)
    longSL := lowerAtrBand - (slMult * prevAtr)
    strategy.entry("Long (ATR Dip)", strategy.long, limit=lowerAtrBand)
    strategy.exit("Exit Long", "Long (ATR Dip)", limit=longTP, stop=longSL)

// 5. Short Strategy Logic (Wick Exhaustion Fading in Bearish Regime)
shortCondition = isShootingStar[1] and isDailyBearish and (strategy.position_size == 0)

var float shortEntryPrice = na
var float shortTP = na
var float shortSL = na

if (shortCondition)
    shortEntryPrice := open
    shortTP := open - (tpMult * prevAtr)
    shortSL := open + (slMult * prevAtr)
    strategy.entry("Short (Shooting Star)", strategy.short)
    // 1-bar time exit or emergency stop
    strategy.exit("Exit Short", "Short (Shooting Star)", stop=shortSL)

// Plot trade shapes
plotshape(longCondition, "Long Signal", shape.triangleup, location.belowbar, color.teal, size=size.small)
plotshape(shortCondition, "Short Signal", shape.triangledown, location.abovebar, color.red, size=size.small)
