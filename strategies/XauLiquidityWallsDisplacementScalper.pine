//@version=6
strategy("XAU Liquidity Walls Displacement Scalper [NujinAI]", "XAU LiqWalls Scalper", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=1.0, commission_type=strategy.commission.percent, commission_value=0.005, slippage=2, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// =============================================================================
// 1. INPUTS & CONFIGURATION
// =============================================================================
grp_liq       = "Liquidity Walls Parameters"
granularity   = input.string("1", "Delta Security Resolution", options=["1", "1S", "1T"], group=grp_liq, tooltip="Resolution for volume delta calculation. Use 1m or lower tf.")
z_threshold   = input.float(2.0, "Absorption Z-Score Threshold", minval=1.0, step=0.1, group=grp_liq)
reg_len       = input.int(100, "Delta-Price Regression Window", minval=20, group=grp_liq)
atr_len       = input.int(14, "ATR Length", minval=5, group=grp_liq)
atr_mult      = input.float(1.0, "Zone Thickness (ATR Mult)", minval=0.5, step=0.1, group=grp_liq)
zone_color    = input.color(#ffcf55, "Liquidity Zone Color", group=grp_liq)

grp_strat     = "Displacement & Execution Rules"
allow_longs   = input.bool(true, "Allow Long Setups", group=grp_strat)
allow_shorts  = input.bool(true, "Allow Short Setups", group=grp_strat)
rrr_ratio     = input.float(2.0, "Risk-to-Reward Ratio (RRR)", minval=1.0, step=0.1, group=grp_strat)
min_wick_pct  = input.float(0.20, "Min Rejection Wick %", minval=0.0, maxval=0.8, step=0.05, group=grp_strat)
max_hold_bars = input.int(30, "Max Holding Bars (Cutoff)", minval=5, maxval=120, group=grp_strat)

grp_session   = "Trading Sessions (UTC)"
filter_sess   = input.bool(true, "Filter by Active Trading Hours", group=grp_session)
sess_hours    = input.session("0700-1700", "London & NY Overlap Window", group=grp_session)

// =============================================================================
// 2. LIQUIDITY WALLS ENGINE (TradingIQ Order Flow Absorption)
// =============================================================================
var string tf_delta = granularity

direction() =>
    math.sign(close - close[1])

z_score(val, len) =>
    (val - ta.sma(val, len)) / ta.stdev(val, len)

// Delta calculation using lower timeframe or current bar proxy
calc_delta() =>
    [signedVol, price] = request.security_lower_tf("", tf_delta, [volume * direction(), close])
    delta_val = signedVol.sum()
    // Fallback if lower tf not accessible on current subscription
    delta_safe = na(delta_val) or delta_val == 0 ? (volume * math.sign(close - open)) : delta_val
    moveTicks = (close - open) / syminfo.mintick

    corr_val = nz(ta.correlation(delta_safe, moveTicks, reg_len)[1])
    std_move = nz(ta.stdev(moveTicks, reg_len)[1])
    std_delt = nz(ta.stdev(delta_safe, reg_len)[1])
    beta     = std_delt > 0 ? (corr_val * (std_move / std_delt)) : 0.0
    alpha    = nz(ta.sma(moveTicks, reg_len)[1] - beta * ta.sma(delta_safe, reg_len)[1])

    expectedTicks = alpha + beta * delta_safe
    expectedClose = open + expectedTicks * syminfo.mintick
    failTicks     = math.sign(expectedTicks) * (expectedTicks - moveTicks)

    [z_score(failTicks, reg_len), expectedTicks, delta_safe, expectedClose]

[z_val, expected_ticks, delta_vol, exp_close] = calc_delta()

atr_val = ta.atr(atr_len)
absorb_side = math.sign(expected_ticks)

// Active Zone Storage
type LiqZone
    box   box_id
    float top
    float bottom
    int   side       // 1 = Resistance/Supply (formed at top), -1 = Support/Demand (formed at bottom)
    int   created_bar
    bool  tapped
    float tap_extreme // lowest low for demand, highest high for supply
    bool  displaced

var LiqZone[] active_zones = array.new<LiqZone>()

// Clean up broken zones (zones violated by price)
if array.size(active_zones) > 0
    for i = array.size(active_zones) - 1 to 0
        z = array.get(active_zones, i)
        // If resistance breached by high > top, invalidate
        if z.side == 1 and high > z.top
            z.box_id.set_extend(extend.none)
            z.box_id.set_right(time)
            z.box_id.set_bgcolor(color.new(color.gray, 92))
            z.box_id.set_border_color(color.new(color.gray, 80))
            array.remove(active_zones, i)
        // If support breached by low < bottom, invalidate
        else if z.side == -1 and low < z.bottom
            z.box_id.set_extend(extend.none)
            z.box_id.set_right(time)
            z.box_id.set_bgcolor(color.new(color.gray, 92))
            z.box_id.set_border_color(color.new(color.gray, 80))
            array.remove(active_zones, i)

// Create New Liquidity Wall when Z >= Threshold
if not na(z_val) and z_val >= z_threshold
    if absorb_side == 1
        // Resistance / Supply liquidity wall above current high
        float z_top = high + atr_mult * atr_val
        float z_bot = high
        box b = box.new(left=time, top=z_top, right=time + 1, bottom=z_bot, xloc=xloc.bar_time, 
                        border_color=color.new(zone_color, 60), bgcolor=color.new(zone_color, 82), extend=extend.right)
        array.push(active_zones, LiqZone.new(b, z_top, z_bot, 1, bar_index, false, high, false))
    else if absorb_side == -1
        // Support / Demand liquidity wall below current low
        float z_top = low
        float z_bot = low - atr_mult * atr_val
        box b = box.new(left=time, top=z_top, right=time + 1, bottom=z_bot, xloc=xloc.bar_time, 
                        border_color=color.new(zone_color, 60), bgcolor=color.new(zone_color, 82), extend=extend.right)
        array.push(active_zones, LiqZone.new(b, z_top, z_bot, -1, bar_index, false, low, false))

// =============================================================================
// 3. CANDLE CONFIRMATION & DISPLACEMENT RECOGNITION
// =============================================================================
ema_50       = ta.ema(close, 50)
is_uptrend   = close > ema_50
is_downtrend = close < ema_50

candle_range = math.max(high - low, syminfo.mintick)
body_range   = math.abs(close - open)
lower_wick   = (math.min(close, open) - low) / candle_range
upper_wick   = (high - math.max(close, open)) / candle_range
is_bullish   = close > open or lower_wick >= min_wick_pct
is_bearish   = close < open or upper_wick >= min_wick_pct

session_ok   = not filter_sess or not na(time(timeframe.period, sess_hours, "UTC"))

bool trigger_long  = false
bool trigger_short = false
float planned_long_entry  = na
float planned_long_sl     = na
float planned_long_tp     = na

float planned_short_entry = na
float planned_short_sl    = na
float planned_short_tp    = na

if array.size(active_zones) > 0 and session_ok and strategy.position_size == 0
    for i = 0 to array.size(active_zones) - 1
        z = array.get(active_zones, i)
        
        // Anti-lookahead: zone must have been formed on a prior candle
        if z.created_bar >= bar_index
            continue

        // ── DEMAND / SUPPORT ZONE (BULLISH SETUP) ──
        if z.side == -1 and allow_longs
            // Check if price taps inside the zone [bottom, top]
            if low <= z.top and low >= z.bottom
                z.tapped := true
                z.tap_extreme := math.min(z.tap_extreme, low)
            
            // Displacement with confirmation:
            // Tapped previously, candle confirms bullish reaction,
            // and price displaces back above the upper border (z.top)
            if z.tapped and not z.displaced
                if high >= z.top and is_bullish
                    // Realistic execution at candle close upon confirmed rejection
                    planned_long_entry := close
                    // Structural SL at the lowest tap point or box bottom
                    planned_long_sl    := math.min(z.tap_extreme, z.bottom) - (0.2 * atr_val)
                    float risk         = planned_long_entry - planned_long_sl
                    if risk > 0
                        planned_long_tp := planned_long_entry + (risk * rrr_ratio)
                        trigger_long    := true
                        z.displaced     := true
                        break

        // ── SUPPLY / RESISTANCE ZONE (BEARISH SETUP) ──
        else if z.side == 1 and allow_shorts
            // Check if price taps inside the zone [bottom, top]
            if high >= z.bottom and high <= z.top
                z.tapped := true
                z.tap_extreme := math.max(z.tap_extreme, high)
            
            // Displacement with confirmation:
            // Tapped previously, candle confirms bearish reaction,
            // and price displaces back below the lower border (z.bottom)
            if z.tapped and not z.displaced
                if low <= z.bottom and is_bearish
                    // Realistic execution at candle close upon confirmed rejection
                    planned_short_entry := close
                    // Structural SL at the highest tap point or box top
                    planned_short_sl    := math.max(z.tap_extreme, z.top) + (0.2 * atr_val)
                    float risk          = planned_short_sl - planned_short_entry
                    if risk > 0
                        planned_short_tp := planned_short_entry - (risk * rrr_ratio)
                        trigger_short    := true
                        z.displaced      := true
                        break

// =============================================================================
// 4. STRATEGY ORDERS EXECUTION (MARKET ON CLOSE DISPLACEMENT TRIGGER)
// =============================================================================
var float active_sl = na
var float active_tp = na
var int   entry_bar = 0

if trigger_long and strategy.position_size == 0
    strategy.entry("Long Displace", strategy.long)
    active_sl := planned_long_sl
    active_tp := planned_long_tp
    entry_bar := bar_index

if trigger_short and strategy.position_size == 0
    strategy.entry("Short Displace", strategy.short)
    active_sl := planned_short_sl
    active_tp := planned_short_tp
    entry_bar := bar_index

// Manage exits with bracket SL and TP
if strategy.position_size > 0
    strategy.exit("Exit Long", "Long Displace", stop=active_sl, limit=active_tp)
    // Time cutoff exit to prevent dead capital
    if bar_index - entry_bar >= max_hold_bars
        strategy.close("Long Displace", comment="Time Exit")

if strategy.position_size < 0
    strategy.exit("Exit Short", "Short Displace", stop=active_sl, limit=active_tp)
    // Time cutoff exit to prevent dead capital
    if bar_index - entry_bar >= max_hold_bars
        strategy.close("Short Displace", comment="Time Exit")

// =============================================================================
// 5. VISUAL TELEMETRY & HUD
// =============================================================================
plot(strategy.position_size != 0 ? active_sl : na, "Stop Loss", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? active_tp : na, "Take Profit (2R)", color=color.green, style=plot.style_linebr, linewidth=2)

var table hud = table.new(position.top_right, 2, 4, bgcolor=color.new(#0e1726, 10), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "Strategy", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "LiqWalls 2R Displace", text_color=color.yellow, text_size=size.small)
    table.cell(hud, 0, 1, "Win Rate", text_color=color.white, text_size=size.small)
    float wr = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100 : 0.0
    table.cell(hud, 1, 1, str.tostring(wr, "#.#") + "%", text_color=wr >= 50 ? color.green : color.red, text_size=size.small)
    table.cell(hud, 0, 2, "Trades Count", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(strategy.closedtrades), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 3, "Net Profit", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, str.tostring(strategy.netprofit, "$#,###"), text_color=strategy.netprofit >= 0 ? color.green : color.red, text_size=size.small)
