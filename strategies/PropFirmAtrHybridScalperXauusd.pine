//@version=5
strategy("Goat Funded Trader Gold ATR Scalper (Trader MNQ)", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, commission_type=strategy.commission.percent, commission_value=0.02)

// -----------------------------------------------------------------------------
// Strategy: Prop Firm ATR Hybrid Scalper on Gold (XAUUSD)
// Reference: IQCapital Prop Firm Trader MNQ Strategy (https://youtu.be/snaP5117MxI)
// Target: Goat Funded Trader (GFT) / FTMO Prop Firm Accounts
// Optimized Microstructure: Long-Only Institutional Dip Absorption + Wick Confirmation
// -----------------------------------------------------------------------------

// Inputs
atrPeriod     = input.int(14, "ATR Period", minval=1)
atrMult       = input.float(2.0, "Gold Dynamic ATR Band Multiplier", step=0.1)
tpMult        = input.float(1.5, "Take Profit Multiplier (x ATR)", step=0.1)
slMult        = input.float(1.2, "Stop Loss Multiplier (x ATR)", step=0.1)
minWickRatio  = input.float(0.25, "Min Absorption Lower Wick Ratio", step=0.05)
maxRiskPct    = input.float(0.5, "Max Account Risk Per Trade (%)", step=0.1)

// 1. Indicator Calculations
atrVal    = ta.atr(atrPeriod)
prevClose = close[1]
prevAtr   = atrVal[1]

// Dynamic Volatility Envelope (Anchored to Previous Bar Close)
lowerAtrBand = prevClose - (atrMult * prevAtr)
upperAtrBand = prevClose + (atrMult * prevAtr)

plot(lowerAtrBand, "Institutional Dip Absorption Band (2.0x ATR)", color=color.new(color.yellow, 20), linewidth=2)
plot(upperAtrBand, "Upper Volatility Envelope", color=color.new(color.gray, 60), linewidth=1, style=plot.style_linebr)

// 2. Candlestick Geometry: Lower Absorption Wick
candleRange = math.max(high - low, syminfo.mintick)
lowerWick   = math.min(close, open) - low
lowerWickRatio = lowerWick / candleRange

// 3. Position Sizing: Strict Prop Firm Risk Budgeting
// Goat Funded Trader rules enforce maximum 4.5% overall drawdown and daily drawdown limits.
// Position size is mathematically scaled so that a full stop loss never exceeds 0.50% equity.
slDistance = slMult * prevAtr
riskEquity = strategy.equity * (maxRiskPct / 100.0)
contractsQty = slDistance > 0 ? (riskEquity / slDistance) : 1.0

// 4. Long Entry Logic (Touches lower ATR band AND confirms with buying absorption wick)
longCondition = (low <= lowerAtrBand) and (lowerWickRatio >= minWickRatio) and not na(prevAtr)

var float longEntryPrice = na
var float longTP = na
var float longSL = na

if (longCondition and strategy.position_size == 0)
    longEntryPrice := close
    longTP := close + (tpMult * prevAtr)
    longSL := close - (slMult * prevAtr)
    strategy.entry("Long (Gold ATR Dip)", strategy.long, qty=contractsQty)
    strategy.exit("Exit Gold Scalp", "Long (Gold ATR Dip)", limit=longTP, stop=longSL)

// Visual Signal Plotting
plotshape(longCondition, "Gold Long Signal", shape.triangleup, location.belowbar, color=color.yellow, size=size.normal, text="GFT BUY")
