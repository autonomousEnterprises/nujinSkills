# ==========================================
# NujinSkills Project .gitignore
# ==========================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/

# --- Temporary & Log Files ---
*.log
server.log
frontend.log
frontend_server.log
.server.pid
.frontend.pid

# --- Node.js & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Extracted Features & Generated Backtest Data ---
data/*.csv
data/*.json
!data/.gitkeep

# --- Freqtrade & Trading Bot Runtime Artifacts ---
user_data/backtest_results/
user_data/logs/
user_data/data/
*.sqlite
*.sqlite-journal

# --- Environment Variables & API Credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
config.json
user_data/config.json

# --- Operating System & IDE Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Editor Specific Directories ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
