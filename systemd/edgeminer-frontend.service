[Unit]
Description=EdgeMiner Telemetry Dashboard Frontend
After=network.target edgeminer-server.service
Wants=edgeminer-server.service

[Service]
Type=simple
WorkingDirectory=/home/christonomous/Desktop/EdgeMiner/frontend
Environment="PATH=/home/christonomous/.nvm/versions/node/v26.1.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/christonomous/Desktop/EdgeMiner/frontend/node_modules/.bin/vite preview --port 3000 --host 0.0.0.0
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=append:/home/christonomous/Desktop/EdgeMiner/frontend_server.log
StandardError=append:/home/christonomous/Desktop/EdgeMiner/frontend_server.log

[Install]
WantedBy=default.target
